# Copier ce fichier en .env et remplacer TOUTES les valeurs.
# Générer un mot de passe : openssl rand -base64 24
# Ne jamais versionner .env (il est dans .gitignore).

POSTGRES_DB=residence
POSTGRES_PASSWORD=changer-moi-superutilisateur

MIGRATOR_PASSWORD=changer-moi-migrations
APP_DB_PASSWORD=changer-moi-api
READONLY_PASSWORD=changer-moi-lecture
REPLICATION_PASSWORD=changer-moi-replication

# Chiffrement des sauvegardes. SI CE MOT DE PASSE EST PERDU, LES SAUVEGARDES
# SONT ILLISIBLES : le conserver dans un gestionnaire de mots de passe.
PGBACKREST_REPO1_CIPHER_PASS=changer-moi-chiffrement-sauvegardes

# Données fictives au premier démarrage (jamais en production)
SEED=true

# Chaînes de connexion pour l'API (apps/api/.env)
# DATABASE_URL=postgresql://app_user:<APP_DB_PASSWORD>@localhost:5432/residence
# DATABASE_URL_REPLICA=postgresql://app_readonly:<READONLY_PASSWORD>@localhost:5433/residence
