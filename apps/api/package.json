{
  "name": "@residence/api",
  "version": "0.1.0",
  "private": true,
  "description": "API du journal de bord des résidences",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:passwords": "tsx scripts/seed-passwords.ts",
    "db:types": "kysely-codegen --dialect postgres --date-parser string --out-file src/db/types.ts --exclude-pattern \"*.{schema_migrations,ops_heartbeat,pg_stat_statements,pg_stat_statements_info}\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
