# Copier en .env et remplacer les valeurs. Ne jamais versionner .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Compte app_user (APP_DB_PASSWORD de database/.env, encodé pour une URL).
# Après une bascule (scripts/failover.sh) : port 5433.
DATABASE_URL=postgresql://app_user:<APP_DB_PASSWORD>@localhost:5432/residence

# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changer-moi-au-moins-32-caracteres-aleatoires

ACCESS_TOKEN_TTL_MINUTES=15
# Durée d'une session (heures). Appareil partagé : en plus, fin à la fermeture du navigateur.
REFRESH_TOKEN_TTL_HOURS=12
# Connexions par minute et par adresse IP (large : le personnel partage le Wi-Fi)
LOGIN_RATE_LIMIT_MAX=30
# Blocage d'un compte après N mauvais mots de passe d'affilée, pendant M minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Courriels (invitations, mot de passe oublié). Développement : Mailpit,
# boîte de réception sur http://localhost:8025 (database/docker-compose.yml).
# Production : SMTP du fournisseur, ex. smtps://utilisateur:motdepasse@smtp.exemple.com:465
APP_URL=http://localhost:5173
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Journal de bord <no-reply@residence.local>

# Derrière un hébergeur : écouter sur toutes les interfaces, et nombre de proxys
# de confiance (vraie adresse IP du client). Vercel → Railway : HOST=0.0.0.0, TRUST_PROXY=2
# HOST=0.0.0.0
TRUST_PROXY=0

# --- Préparation d'une base hébergée : npm run db:setup (étape pre-deploy) ---
# Compte administrateur (Railway : ${{Postgres.DATABASE_URL}} ; RDS : compte maître).
# Le mot de passe de app_user est repris de DATABASE_URL ci-dessus.
# DATABASE_ADMIN_URL=postgresql://postgres:...@localhost:5432/residence
# Données FICTIVES au premier déploiement (jamais avec de vraies données)
# SEED_DEMO=true
# SEED_PASSWORD=un-mot-de-passe-de-demo-solide
