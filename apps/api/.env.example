# Copier en .env et remplacer les valeurs. Ne jamais versionner .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Compte app_user (APP_DB_PASSWORD de database/.env, encodé pour une URL).
# Après une bascule (scripts/failover.sh) : port 5433.
DATABASE_URL=postgresql://app_user:<APP_DB_PASSWORD>@localhost:5432/residence

# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changer-moi-au-moins-32-caracteres-aleatoires

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT_MAX=10
